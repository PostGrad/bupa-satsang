{
  "name": "client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/client/app",
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/client",
        "command": "pnpm exec expo start"
      }
    },
    "web-build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/client",
        "command": "pnpm exec expo export --platform web"
      }
    },
    "android-build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/client",
        "command": "pnpm exec expo prebuild --platform android --no-install && ./android/gradlew -p android assembleRelease"
      }
    },
    "android-run": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/client",
        "command": "pnpm exec expo run:android --variant release"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/client",
        "command": "pnpm exec tsc --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "pnpm exec eslint apps/client"
      }
    }
  }
}
