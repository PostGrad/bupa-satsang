{
  "name": "bupa-satsang",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start:api": "pnpm exec nx run api:serve",
    "start:client": "pnpm exec nx run client:start",
    "test:unit": "vitest run --exclude 'apps/api/test/**/*.test.ts'",
    "test:api": "vitest run --config vitest.integration.config.ts",
    "test:web": "playwright test",
    "typecheck": "pnpm exec nx run-many -t typecheck --all",
    "lint": "pnpm exec nx run-many -t lint --all"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "eslint": "10.10.0",
    "nx": "23.2.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
